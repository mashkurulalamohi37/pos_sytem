<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12+ (API 31+)
    This file specifies which files should be backed up and which should be excluded.
-->
<full-backup-content>
    <!-- Include shared preferences domain first, then exclude sensitive files -->
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="flutter_shared_preferences.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    
    <!-- Include app data that should be backed up -->
    <include domain="file" path="."/>
    <include domain="database" path="."/>
</full-backup-content>

