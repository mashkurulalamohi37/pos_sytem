<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+)
    This file specifies which files can be accessed by other apps.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include shared preferences domain first, then exclude sensitive files -->
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="flutter_shared_preferences.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Allow device-to-device transfer of app data -->
        <include domain="file" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>

