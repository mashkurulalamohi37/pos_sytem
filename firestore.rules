rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Helper function to check if user is manager
    function isManager() {
      return hasRole('manager');
    }
    
    // Helper function to check if user is cashier
    function isCashier() {
      return hasRole('cashier');
    }
    
    // Helper function to check if user is admin or manager
    function isAdminOrManager() {
      return isAdmin() || isManager();
    }
    
    // Helper function to check if user is active
    function isUserActive() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().isActive == true;
    }
    
    // Helper function to validate required fields
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    // Only admins can read/write user documents
    // Users can read their own document
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || isAdmin());
      
      // Only admins can create users
      allow create: if isAdmin() && 
                       isUserActive() &&
                       hasRequiredFields(['username', 'role', 'createdAt', 'updatedAt']) &&
                       request.resource.data.role in ['admin', 'manager', 'cashier'] &&
                       request.resource.data.isActive == true;
      
      // Only admins can update users
      // Users cannot change their own role
      allow update: if isAdmin() && 
                       isUserActive() &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || 
                        request.auth.uid != userId);
      
      // Only admins can delete users
      // Admins cannot delete themselves
      allow delete: if isAdmin() && 
                       isUserActive() && 
                       request.auth.uid != userId;
    }
    
    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    // All authenticated users can read products
    // Only admin/manager can create/update/delete
    match /products/{productId} {
      // All authenticated active users can read products
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin/manager can create products
      allow create: if isAdminOrManager() && 
                       isUserActive() &&
                       hasRequiredFields(['name', 'price', 'stockQuantity', 'createdAt', 'updatedAt']);
      
      // Only admin/manager can update products
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin/manager can delete products
      allow delete: if isAdminOrManager() && isUserActive();
    }
    
    // ============================================
    // CATEGORIES COLLECTION
    // ============================================
    // All authenticated users can read categories
    // Only admin/manager can create/update/delete
    match /categories/{categoryId} {
      // All authenticated active users can read categories
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin/manager can create categories
      allow create: if isAdminOrManager() && 
                       isUserActive() &&
                       hasRequiredFields(['name', 'createdAt', 'updatedAt']);
      
      // Only admin/manager can update categories
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin/manager can delete categories
      allow delete: if isAdminOrManager() && isUserActive();
    }
    
    // ============================================
    // CUSTOMERS COLLECTION
    // ============================================
    // All authenticated users can read customers
    // Only admin/manager can create/update/delete
    match /customers/{customerId} {
      // All authenticated active users can read customers
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin/manager can create customers
      allow create: if isAdminOrManager() && 
                       isUserActive() &&
                       hasRequiredFields(['name', 'createdAt', 'updatedAt']);
      
      // Only admin/manager can update customers
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin/manager can delete customers
      allow delete: if isAdminOrManager() && isUserActive();
    }
    
    // ============================================
    // SALES COLLECTION
    // ============================================
    // All authenticated users can read sales
    // All authenticated users can create sales (for POS)
    // Only admin/manager can update/delete sales
    match /sales/{saleId} {
      // All authenticated active users can read sales
      allow read: if isAuthenticated() && isUserActive();
      
      // All authenticated users can create sales (for POS checkout)
      allow create: if isAuthenticated() && 
                        isUserActive() &&
                        hasRequiredFields(['userId', 'branchId', 'subtotal', 'totalAmount', 'paymentMethod', 'status', 'createdAt']) &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.status == 'completed';
      
      // Only admin/manager can update sales (for refunds, corrections)
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin can delete sales
      allow delete: if isAdmin() && isUserActive();
      
      // ============================================
      // SALE ITEMS SUBCOLLECTION
      // ============================================
      match /items/{itemId} {
        // All authenticated active users can read sale items
        allow read: if isAuthenticated() && isUserActive();
        
        // Can only create items when creating a sale
        allow create: if isAuthenticated() && 
                         isUserActive() &&
                         hasRequiredFields(['productId', 'productName', 'unitPrice', 'quantity', 'total', 'createdAt']);
        
        // Only admin/manager can update sale items
        allow update: if isAdminOrManager() && isUserActive();
        
        // Only admin can delete sale items
        allow delete: if isAdmin() && isUserActive();
      }
    }
    
    // ============================================
    // CASH SESSIONS COLLECTION
    // ============================================
    // Users can read their own cash sessions
    // Admin/manager can read all cash sessions
    // Users can create their own cash sessions
    // Only admin/manager can update/delete cash sessions
    match /cashSessions/{sessionId} {
      // Users can read their own sessions, admin/manager can read all
      allow read: if isAuthenticated() && 
                     isUserActive() && 
                     (resource.data.userId == request.auth.uid || isAdminOrManager());
      
      // Users can create their own cash sessions
      allow create: if isAuthenticated() && 
                        isUserActive() &&
                        hasRequiredFields(['userId', 'branchId', 'openingCash', 'openedAt', 'status']) &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.status == 'open';
      
      // Users can update their own open sessions, admin/manager can update any
      allow update: if isAuthenticated() && 
                        isUserActive() &&
                        (resource.data.userId == request.auth.uid || isAdminOrManager()) &&
                        // Prevent changing userId
                        request.resource.data.userId == resource.data.userId;
      
      // Only admin can delete cash sessions
      allow delete: if isAdmin() && isUserActive();
    }
    
    // ============================================
    // TAX RATES COLLECTION
    // ============================================
    // All authenticated users can read tax rates
    // Only admin/manager can create/update/delete
    match /taxRates/{taxRateId} {
      // All authenticated active users can read tax rates
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin/manager can create tax rates
      allow create: if isAdminOrManager() && 
                       isUserActive() &&
                       hasRequiredFields(['name', 'rate', 'createdAt', 'updatedAt']);
      
      // Only admin/manager can update tax rates
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin/manager can delete tax rates
      allow delete: if isAdminOrManager() && isUserActive();
    }
    
    // ============================================
    // STOCK LEVELS COLLECTION
    // ============================================
    // All authenticated users can read stock levels
    // Only admin/manager can create/update/delete
    match /stockLevels/{stockLevelId} {
      // All authenticated active users can read stock levels
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin/manager can create stock levels
      allow create: if isAdminOrManager() && isUserActive();
      
      // Only admin/manager can update stock levels
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin/manager can delete stock levels
      allow delete: if isAdminOrManager() && isUserActive();
    }
    
    // ============================================
    // STOCK MOVEMENTS COLLECTION
    // ============================================
    // All authenticated users can read stock movements
    // Only admin/manager can create/update/delete
    match /stockMovements/{movementId} {
      // All authenticated active users can read stock movements
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin/manager can create stock movements
      allow create: if isAdminOrManager() && 
                       isUserActive() &&
                       hasRequiredFields(['productId', 'branchId', 'movementType', 'quantity', 'createdAt']);
      
      // Only admin/manager can update stock movements
      allow update: if isAdminOrManager() && isUserActive();
      
      // Only admin can delete stock movements
      allow delete: if isAdmin() && isUserActive();
    }
    
    // ============================================
    // BRANCHES COLLECTION
    // ============================================
    // All authenticated users can read branches
    // Only admin can create/update/delete branches
    match /branches/{branchId} {
      // All authenticated active users can read branches
      allow read: if isAuthenticated() && isUserActive();
      
      // Only admin can create branches
      allow create: if isAdmin() && 
                       isUserActive() &&
                       hasRequiredFields(['name', 'createdAt', 'updatedAt']);
      
      // Only admin can update branches
      allow update: if isAdmin() && isUserActive();
      
      // Only admin can delete branches
      allow delete: if isAdmin() && isUserActive();
    }
    
    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

